
FROM php:8.3-cli

# Extensões e dependências
RUN apt-get update && apt-get install -y \
    git unzip curl libzip-dev libpng-dev libonig-dev libxml2-dev \
    && docker-php-ext-install pdo pdo_mysql zip mbstring bcmath \
    && rm -rf /var/lib/apt/lists/*

# Node 20
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Primeiro copia os manifests
COPY composer.json composer.lock ./
COPY package.json package-lock.json ./

# Instala dependências sem executar scripts do Laravel
RUN composer install --no-interaction --prefer-dist --no-scripts \
    && npm install

# Agora copia o restante da aplicação
COPY . .

# Executa a descoberta dos pacotes com artisan disponível
RUN composer run-script post-autoload-dump

EXPOSE 8000 5173

CMD ["sh", "-c", "php artisan serve --host=0.0.0.0 --port=8000 & npm run dev -- --host 0.0.0.0"]
